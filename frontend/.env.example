# Production: Render API origin — no trailing slash, no `/api` suffix.
# Set the same value in Vercel → Project → Environment Variables.
VITE_API_URL=https://survey-app-backend-v1ot.onrender.com

# Alias (same as VITE_API_URL):
# VITE_API_BASE_URL=https://survey-app-backend-v1ot.onrender.com

# Local dev: optional override for Vite proxy target (default http://localhost:4000)
# VITE_API_PROXY_TARGET=http://localhost:4000

# Optional: comma-separated hostnames for `npm run dev` (e.g. ngrok tunnel hostname)
# VITE_DEV_ALLOWED_HOSTS=your-app.ngrok-free.dev
